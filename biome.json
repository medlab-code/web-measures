{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "index.html"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "rules": {
      "preset": "none",
      "correctness": {
        "preset": "recommended",
        "noUnusedFunctionParameters": "off",
        "noUnusedVariables": "warn"
      },
      "suspicious": {
        "preset": "recommended",
        "noAssignInExpressions": "off",
        "noCatchAssign": "off",
        "noGlobalIsNan": "off",
        "useIterableCallbackReturn": "off"
      }
    }
  },
  "javascript": {
    "globals": [
      "maplibregl",
      "loadPyodide",
      "qrcode",
      "shp",
      "initSqlJs",
      "createLazPerf",
      "Mp4Muxer"
    ]
  },
  "overrides": [
    {
      "includes": [
        "src/**",
        "tests/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "error"
          }
        }
      }
    },
    {
      "includes": [
        "tests/**"
      ],
      "javascript": {
        "globals": [
          "Essai",
          "PassagesPietons"
        ]
      }
    },
    {
      "includes": [
        "tests/passages-pietons.js"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ]
}
