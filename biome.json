{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": { "includes": ["src/**", "tests/**", "index.html", "mobile.html"] },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "rules": {
      "preset": "none",
      "correctness": {
        "preset": "recommended",
        "noUnusedFunctionParameters": "off",
        "noUnusedVariables": {
          "level": "warn",
          "options": {
            "ignore": {
              "variable": ["Attente", "Calage", "Calcul", "Carte", "Choix", "Couche", "Dessus", "Disposition", "Essai", "Favoris", "Fiche", "Lieu",
                "Mesure", "Nez", "Nuage", "Objets", "Parcours", "PassagesPietons", "Profil", "Recherche", "Reglages",
                "Releve", "Requeteur", "Resultats", "Services", "Traits", "Video", "Vignette", "Visionneuse"]
            }
          }
        }
      },
      "suspicious": {
        "preset": "recommended",
        "noAssignInExpressions": "off",
        "noCatchAssign": "off",
        "noGlobalIsNan": "off",
        "useIterableCallbackReturn": "off"
      }
    }
  }
}
